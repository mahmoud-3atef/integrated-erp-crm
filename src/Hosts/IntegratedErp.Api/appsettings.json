{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Modules": {
    "Organization": {
      "Enabled": true
    },
    "Identity": {
      "Enabled": true
    },
    "Documents": {
      "Enabled": true
    }
  },
  "Documents": {
    "MaxFileSizeMb": 20
  }
}
