{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Modules": {
    "Organization": {
      "Enabled": true
    },
    "Identity": {
      "Enabled": true
    },
    "Documents": {
      "Enabled": true
    },
    "Workflow": {
      "Enabled": true
    },
    "CrmSync": {
      "Enabled": true
    },
    "Workforce": {
      "Enabled": true
    }
  },
  "CrmSync": {
    "ConnectionString": "",
    "Company": "",
    "IntervalMinutes": 0,
    "PageSize": 1000,
    "CreatedFrom": {
      "systemuser": "2025-01-01",
      "team": "2025-01-01",
      "new_employee": "2025-01-01"
    }
  },
  "Documents": {
    "MaxFileSizeMb": 20
  }
}
